# =============================================================================
# MarketFlux Backend Environment Variables
# Copy to .env. Never commit real values.
# =============================================================================

# development | test | production
# Unset is treated as production: auth is required and localhost CORS is off.
MARKETFLUX_ENV=development

# --- MongoDB (still required) ---
# Supabase is the primary auth and Postgres store. Copilot history, news,
# rate-limit counters, and several other collections still live in MongoDB.
MONGO_URL=mongodb://localhost:27017
DB_NAME=marketflux

# --- Core ---
# Required unless SUPABASE_URL and SUPABASE_ANON_KEY (or SERVICE_KEY) are set.
JWT_SECRET=your-secret-key-at-least-32-chars-long-here

# --- CORS ---
# Production must be the public frontend origin. Localhost is added only when
# MARKETFLUX_ENV is development or test.
ALLOWED_ORIGINS=http://localhost:3000

# --- Public demo ---
# DEMO_MODE=true forces paper confirm-before-trade, disables standing agents
# and the Python scratchpad, and lowers the default daily copilot cap to 20.
DEMO_MODE=false
# Do not enable on a public host. pandas/numpy can read the server filesystem.
ENABLE_CODE_SANDBOX=false
# Per-IP limit on copilot chat, trade approval, and standing-agent runs.
COPILOT_RATE_LIMIT=10/minute
# Daily copilot turns per user. Unset means 50, or 20 when DEMO_MODE=true. 0 disables.
COPILOT_DAILY_TURNS=50

# --- AI / LLM ---
GEMINI_API_KEY=your-gemini-api-key
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA_NIM_API_KEY=your-nvidia-nim-key
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Market data (optional; features degrade without them) ---
# ALPHA_VANTAGE_KEY=
# FINNHUB_KEY=
# FRED_API_KEY=
# TAVILY_API_KEY=

# --- Supabase (primary auth + durable Postgres / pgvector) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# MARKETFLUX_VNEXT_DATABASE_URL=
# FUNDOS_DATABASE_URL=

# --- Redis (optional cache). REDIS_URL wins, including TLS rediss:// ---
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://:password@your-host:6379/0
# Legacy fallback used only when REDIS_URL is unset:
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# FUNDOS_REDIS_URL=

# --- Alpaca paper trading (paper=True is hardcoded) ---
ALPACA_MODE=trading
APCA_API_KEY_ID=your-paper-api-key-id
APCA_API_SECRET_KEY=your-paper-api-secret-key
# ALPACA_BROKER_API_KEY=
# ALPACA_BROKER_API_SECRET=

# --- Conviction ledger nightly grade ---
# LEDGER_GRADE_TOKEN=
# LEDGER_AUTOLOG_SCORE=30

# --- Copilot risk caps ---
# COPILOT_MAX_ORDER_NOTIONAL=60000
# COPILOT_WARN_POSITION_PCT=18
# COPILOT_MAX_POSITION_PCT=30
# COPILOT_PENNY_PRICE=1.0

# Dev only. Applies the vnext SQL migration when the theses table is missing.
# MARKETFLUX_AUTO_APPLY_SCHEMA=false
