# =============================================================================
# MarketFlux Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.

# --- Core ---
JWT_SECRET=your-secret-key-at-least-32-chars-long-here

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- AI / LLM ---
GEMINI_API_KEY=your-gemini-api-key
# OPENROUTER_API_KEY=your-openrouter-key
# NVIDIA_NIM_API_KEY=your-nvidia-nim-key

# --- Market Data ---
# ALPHA_VANTAGE_KEY=your-key
# FINNHUB_KEY=your-key
# FRED_API_KEY=your-key

# --- Search ---
# TAVILY_API_KEY=your-key

# --- Supabase (primary auth + durable data) ---
# REQUIRED for login + the Copilot: SUPABASE_URL plus at least ONE of
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_KEY, and it MUST be the same project the
# frontend (REACT_APP_SUPABASE_URL) logs into — otherwise the backend can't verify
# the user's token and every authenticated call (e.g. /api/copilot/chat/stream)
# returns 401. SUPABASE_DB_URL is only needed for long-term memory (pgvector).
# Project URL + keys from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Primary data layer (REQUIRED) ---
# The backend refuses to boot without MONGO_URL — auth sessions, trades,
# portfolios, watchlists, and all copilot/pilot state live here.
# docker-compose provides it automatically (service name "mongo").
MONGO_URL=mongodb://localhost:27017
DB_NAME=marketflux

# --- Redis (hot memory layer) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================================================
# Alpaca Paper Trading
# =============================================================================
# ALPACA_MODE controls which API is used:
#   "trading" (default) — single shared paper account, uses APCA_* keys
#   "broker"            — per-user sub-accounts, uses ALPACA_BROKER_* keys
#
ALPACA_MODE=trading

# --- Trading API (default mode) ---
# Standard paper keys from https://app.alpaca.markets
APCA_API_KEY_ID=your-paper-api-key-id
APCA_API_SECRET_KEY=your-paper-api-secret-key

# --- Broker API (multi-tenant mode) ---
# Per-user sub-accounts. Get from: https://broker-app.alpaca.markets
# Set ALPACA_MODE=broker to activate.
# ALPACA_BROKER_API_KEY=your-broker-client-id
# ALPACA_BROKER_API_SECRET=your-broker-client-secret

# --- Conviction Ledger ---
# Shared secret for the nightly grading cron (POST /api/ledger/grade).
# Must match the LEDGER_GRADE_TOKEN GitHub Actions secret. Required in production.
# LEDGER_GRADE_TOKEN=generate-a-long-random-string
# Auto-log threshold: |composite_score| needed before a sized copilot call
# becomes a recorded thesis (default 30).
# LEDGER_AUTOLOG_SCORE=30
# Per-user daily copilot turn budget (cost guardrail; 0 disables). Default 50.
# COPILOT_DAILY_TURNS=50

# =============================================================================
# Safety Controls (god-tier hardening)
# =============================================================================
# Global trading kill switch: when true, every order-placement path
# (copilot place_order tool, staged-trade approvals, pilot proposal execution,
# Alpaca REST order endpoints) rejects with 403. No restart needed to engage.
# Can also be toggled at runtime: POST /api/admin/trading-halt with the
# X-Admin-Token header (see ADMIN_TOKEN below).
# TRADING_HALTED=false

# Shared secret gating the /api/admin/trading-halt endpoints.
# If set, the X-Admin-Token header must match; in production a missing
# ADMIN_TOKEN disables the admin endpoints outright.
# ADMIN_TOKEN=<redacted>

# Per-minute sliding-window rate limit for copilot chat turns (default 20).
# Redis-backed when REDIS_URL is set, otherwise in-memory per process.
# COPILOT_CHAT_PER_MINUTE=20
# REDIS_URL=redis://localhost:6379/0
