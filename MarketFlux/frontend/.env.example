# MarketFlux Frontend Environment Variables
# Copy to .env.local for `yarn start`. Production builds (yarn build, Vercel)
# fail if REACT_APP_BACKEND_URL is missing.

REACT_APP_BACKEND_URL=http://localhost:8000

# --- Supabase Auth (anon key is public; row level security protects data) ---
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Show the paper-trading banner even before the API health check returns.
# The backend DEMO_MODE flag is the source of truth once /api/health loads.
REACT_APP_DEMO_MODE=false

# Production builds also read frontend/.env.production, which sets
# GENERATE_SOURCEMAP=false.
